# Service Configuration
APP_NAME="GotiHub-Gemma-Bridge"
APP_ENV=development
DEBUG=true
PORT=8001

# AI Model Configuration
# In production, these should be set to the actual model endpoint and name
GEMMA_MODEL_ENDPOINT="http://localhost:11434/v1"
GEMMA_MODEL_NAME="gemma2:9b"
REASONING_CONFIDENCE_THRESHOLD=0.85

# Security
# In production, this should be a strong secret key
API_BEARER_TOKEN="your-super-secret-token-for-laravel-handshake"